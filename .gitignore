# Generated by Cargo
# will have compiled files and executables
/target
node_modules/
apps/vision/.venv/
apps/vision/__pycache__/
apps/vision/**/__pycache__/
*.pyc
cache/*
!cache/.gitkeep
models/*
!models/.gitkeep
# Vendored stable-diffusion.cpp checkout (build dependency for sd-server;
# it has its own git repository and is not part of this project)
stable-diffusion.cpp/
.DS_Store

# Generated images imported by the app at runtime. This stays at the workspace
# root on purpose: revisions record absolute asset paths, so moving it would
# orphan every image an existing project database refers to.
/assets/generated/

# SQLite project databases (replaces the stopgap JSON project file)
.svs-project.db

# Compiled Tailwind output; regenerate with `npm run css:build` from apps/desktop
# (or `dx`, which compiles it automatically from that crate's tailwind.css)
/apps/desktop/assets/tailwind.css

# These are backup files generated by rustfmt
**/*.rs.bk

# Local E2E validation scratch
.svs-e2e/

# Bundled desktop artifacts from `cargo xtask bundle` (AppImage/.deb/…)
/dist/

# Runtime-generated segmentation masks (SVS_MASK_DIR output)
/apps/vision/assets/masks/
