# Generated by Cargo
# will have compiled files and executables
/target
node_modules/
python/.venv/
python/__pycache__/
python/**/__pycache__/
*.pyc
cache/*
!cache/.gitkeep
models/*
!models/.gitkeep
.DS_Store

# Generated images imported by the app at runtime
/assets/generated/

# Compiled Tailwind output; regenerate with `npm run css:build` (or `dx`, which
# compiles it automatically from the root tailwind.css)
/assets/tailwind.css

# These are backup files generated by rustfmt
**/*.rs.bk
